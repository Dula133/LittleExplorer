+#ventButtons{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px}#ventButtons .key{min-height:60px;padding:3px 1px;gap:1px}#ventButtons .btn-symbol{font-size:20px;margin:0}#ventButtons .en{font-size:8px}
