+@media(max-width:560px){.music-heading{align-items:flex-start;flex-direction:column}.music-transport{gap:4px}.music-transport label{font-size:8px}.hvac-feedback small{font-size:8px}}
+/* A real centre-horn target, inside the existing wheel and clear of steering controls. */
+button.wheel-center{min-width:44px;min-height:44px;padding:0;color:#f3ffff;font-size:20px;touch-action:manipulation;cursor:pointer}
+button.wheel-center:active{transform:translate(-50%,-50%) scale(.96)}
+.footer #audioMute{min-width:44px;min-height:44px;font-size:20px;flex-shrink:0}
