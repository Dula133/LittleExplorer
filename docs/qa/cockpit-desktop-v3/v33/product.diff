+/* V3.3 additions stay inside the accepted cockpit regions. */
+#reverseNotice{position:absolute;z-index:8;bottom:8px;left:50%;transform:translateX(-50%);max-width:64%;padding:5px 9px;border-radius:8px;background:#173b4aee;color:#ffdf9e;font-size:clamp(8px,.8vw,11px);text-align:center;pointer-events:none}
+.world .road-dash{animation:none}.fog-lamp-cones{opacity:0;transition:opacity .35s;pointer-events:none}
+.audio-levels{display:grid;grid-template-columns:1fr 1fr;gap:10px}.audio-levels label{font-size:10px;color:#bdd7e0;display:flex;align-items:center;gap:4px}.audio-levels input{width:100%;min-width:0;accent-color:#62e4d2;min-height:28px}#engineAudioStatus{font-size:10px;color:#a9ccd7}
+/* Outdoor fog leaves the near road readable; fog lamps light only the foreground. */
+.foggy .fog-screen{opacity:.85;background:linear-gradient(to bottom,#dbe5e7b8 0%,#dae5e9cf 43%,#d7e3e779 64%,#d8e5e210 100%)}
+.foggy #mountainParallax{filter:blur(2.8px) saturate(.45) contrast(.5)}.foggy #nearParallax{filter:blur(.9px) contrast(.7)}
+.foggy #roadScenery{mask-image:linear-gradient(to bottom,#0000 26%,#0004 48%,#000 95%)}
+.fog-light-overlay{position:absolute;inset:0;width:100%;height:100%;z-index:4;pointer-events:none;opacity:0;transition:opacity .35s}.fog-lamps-on .fog-light-overlay{opacity:.65}
+#rainButtons{grid-template-columns:repeat(7,minmax(0,1fr))}
+@media(max-width:999px){#rainButtons{grid-template-columns:repeat(3,minmax(0,1fr))}}
+/* Indoor moisture is separate from outdoor weather and is swept by neither wiper. */
