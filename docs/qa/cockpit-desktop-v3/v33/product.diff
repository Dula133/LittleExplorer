+      "duration": 5.352,
+      "sha256": "5209ce6afdbd929e0f5234ea689ed0a6adef115b677acbceff07498ab9b75277",
+      "decode": "PASS"
+    },
+    {
+      "id": "b7c62e77723c716f",
+      "text": "换到 R 挡。倒车模式。继续下一步。",
