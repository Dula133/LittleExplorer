@@ -0,0 +1,873 @@
+{
+  "schemaVersion": 1,
+  "language": "zh-CN",
+  "voice": "zh-CN-YunxiaNeural",
+  "rate": "-8%",
+  "channel": "independent cockpit speech; does not change original voice mappings",
+  "clips": [
+    {
+      "id": "72ab4b07e6e978f5",
+      "text": "灯光：自动。天黑会自动开灯。",
+      "file": "../assets/cockpit-voice/72ab4b07e6e978f5.mp3",
+      "bytes": 27936,
+      "duration": 4.656,
+      "sha256": "633694872710264cd6cd936543b565b996c2e678b1d2c3054371d3d233c3b5d5",
+      "decode": "PASS"
+    },
+    {
+      "id": "9ab0ca4e9dbd4de8",
+      "text": "灯光：小灯。小灯让别人更容易看见汽车。",
+      "file": "../assets/cockpit-voice/9ab0ca4e9dbd4de8.mp3",
+      "bytes": 34128,
+      "duration": 5.688,
+      "sha256": "3cdeff95cbd1624047bae24c7499bbb3017692e1cb6499598bccdc49b9491257",
+      "decode": "PASS"
+    },
+    {
+      "id": "7520065e11dc235f",
+      "text": "灯光：大灯。大灯照亮汽车前面的路。",
+      "file": "../assets/cockpit-voice/7520065e11dc235f.mp3",
+      "bytes": 30384,
+      "duration": 5.064,
+      "sha256": "b5013c98d16029f1dcaf97db84a76d9397947ca16c5270c2641142cbe39157b5",
+      "decode": "PASS"
+    },
+    {
+      "id": "2e4a17bb217c1821",
+      "text": "灯光：关闭。车灯关掉了。",
+      "file": "../assets/cockpit-voice/2e4a17bb217c1821.mp3",
+      "bytes": 25632,
+      "duration": 4.272,
+      "sha256": "46edba31ff967ce6e06bce87d1dd061c87a2d52e907fb92180811a946c1144c8",
+      "decode": "PASS"
+    },
+    {
+      "id": "ea7b02c63c41353e",
+      "text": "转向灯关闭。灯不闪啦。",
+      "file": "../assets/cockpit-voice/ea7b02c63c41353e.mp3",
+      "bytes": 23616,
+      "duration": 3.936,
+      "sha256": "95f31e592e8dd90453cc6c27b16210d1da967fec6a90c8788ba69a9d14ed863e",
+      "decode": "PASS"
+    },
+    {
+      "id": "00483fef066855d0",
+      "text": "左转向灯。我要向左走。",
+      "file": "../assets/cockpit-voice/00483fef066855d0.mp3",
+      "bytes": 22320,
+      "duration": 3.72,
+      "sha256": "f54895431693d0636ae594c6b3a03599adecb1c14f24e4a598b30fc059747962",
+      "decode": "PASS"
+    },
+    {
+      "id": "56a566177d0224d0",
+      "text": "右转向灯。我要向右走。",
+      "file": "../assets/cockpit-voice/56a566177d0224d0.mp3",
+      "bytes": 22176,
+      "duration": 3.696,
+      "sha256": "61664eb80568a1c5d935f5b40d9b1d6b49a6e4204e4ecf259b1cb069d8a8f1f4",
+      "decode": "PASS"
+    },
+    {
+      "id": "c53048048ea3ee57",
+      "text": "双闪打开啦。左右一起闪，提醒其他车辆注意。",
+      "file": "../assets/cockpit-voice/c53048048ea3ee57.mp3",
+      "bytes": 36288,
+      "duration": 6.048,
+      "sha256": "83fd61d5ec74287b71dcb2701b9141007b9c0e49b47a7ebd66622fda2af5cec2",
+      "decode": "PASS"
+    },
+    {
+      "id": "4af4dae27e0ac22b",
+      "text": "雾灯打开。在雾天帮助看清附近道路。",
+      "file": "../assets/cockpit-voice/4af4dae27e0ac22b.mp3",
+      "bytes": 31680,
+      "duration": 5.28,
+      "sha256": "4cb6df184ff8f5d15ed027c81ccf68867fceb75fd1761a2c9aef2e8bfc5100df",
+      "decode": "PASS"
+    },
+    {
+      "id": "476371813c825573",
+      "text": "雾灯关闭。雾灯关掉啦。",
+      "file": "../assets/cockpit-voice/476371813c825573.mp3",
+      "bytes": 22320,
+      "duration": 3.72,
+      "sha256": "e2dc026618bfda9bda9d18f11ecfb5fec7cf944cf12c748c0aa8ad5871f77c43",
+      "decode": "PASS"
+    },
+    {
+      "id": "3193c6a5e397c8cd",
+      "text": "天气：晴天。天气晴朗，雨刮档位可以独立选择。",
+      "file": "../assets/cockpit-voice/3193c6a5e397c8cd.mp3",
+      "bytes": 40752,
+      "duration": 6.792,
+      "sha256": "a02d3823b476d4559472e6cc711e6daff48fb0e53226f753033a78c39d3e751a",
+      "decode": "PASS"
+    },
+    {
+      "id": "edeadae74cd7f4fb",
+      "text": "天气：小雨。下起小雨。",
+      "file": "../assets/cockpit-voice/edeadae74cd7f4fb.mp3",
+      "bytes": 25344,
+      "duration": 4.224,
+      "sha256": "a21d18ad5072c933b26019fa0e93d7849148cf3bcadbc5a426ddb04d5bd74ecf",
+      "decode": "PASS"
+    },
+    {
+      "id": "c25e8bb2e2fa1dc8",
+      "text": "天气：中雨。雨变大了。",
+      "file": "../assets/cockpit-voice/c25e8bb2e2fa1dc8.mp3",
+      "bytes": 24768,
+      "duration": 4.128,
+      "sha256": "1996b6ad898f1e9a6a7916a07dd32003b179658bbc0df22fc951b1cc2271a476",
+      "decode": "PASS"
+    },
+    {
+      "id": "852734929e9b31b8",
+      "text": "天气：大雨。大雨来了！",
+      "file": "../assets/cockpit-voice/852734929e9b31b8.mp3",
+      "bytes": 23904,
+      "duration": 3.984,
+      "sha256": "6850ce408f755cdda055bb1bc5575f6e006a63974c235fb455e411d4ffdfde7e",
+      "decode": "PASS"
+    },
+    {
+      "id": "72071af262a1d589",
+      "text": "天气：大暴雨。雨更密、更快了，已开启高速雨刮，也可以手动调速。",
+      "file": "../assets/cockpit-voice/72071af262a1d589.mp3",
+      "bytes": 50832,
+      "duration": 8.472,
+      "sha256": "f7440d7809a5df51cf33e7bd5afff8f40fa882e0f18776a9f696a53a3a661d07",
+      "decode": "PASS"
+    },
+    {
+      "id": "3b9d4c8f8b73fce1",
+      "text": "天气：大暴雨。保持你选择的雨刮速度。",
+      "file": "../assets/cockpit-voice/3b9d4c8f8b73fce1.mp3",
+      "bytes": 31680,
+      "duration": 5.28,
+      "sha256": "ef78338f6238b68c22354fc44a8a05f5f2a2db61e664deda70554989e1e3b419",
+      "decode": "PASS"
+    },
+    {
+      "id": "859e7515b70f8ad8",
+      "text": "天气：下雪。下雪啦！看，雪花在玻璃前飘。",
+      "file": "../assets/cockpit-voice/859e7515b70f8ad8.mp3",
+      "bytes": 41904,
+      "duration": 6.984,
+      "sha256": "8284927bd69939921abc1dfaea6105023352403e85ec67e6bfcd1dea8b0fb675",
+      "decode": "PASS"
+    },
+    {
+      "id": "ccd9740b78e468f8",
+      "text": "天气：雾天。远处有雾，附近道路仍然看得见。雾灯可单独打开，不能消除室外雾。",
+      "file": "../assets/cockpit-voice/ccd9740b78e468f8.mp3",
+      "bytes": 61920,
+      "duration": 10.32,
+      "sha256": "88fa3aaa5acb15be15b1b36c2fd37e2c101f1e76f24c213dce71ba4b62432516",
+      "decode": "PASS"
+    },
+    {
+      "id": "80c237b84f3eaadb",
+      "text": "雨刮正在归位。两个雨刮会回到玻璃下缘。",
+      "file": "../assets/cockpit-voice/80c237b84f3eaadb.mp3",
+      "bytes": 31392,
+      "duration": 5.232,
+      "sha256": "914733ff3d49e100e38e27bb0c3ee879fe1a2eed4cdac94bce92f55461ac9296",
+      "decode": "PASS"
+    },
+    {
+      "id": "22e30eeccd93e575",
+      "text": "雨刮器低速摆动。两个雨刮一起扫过玻璃。天气不会改变你手动选择的档位。",
+      "file": "../assets/cockpit-voice/22e30eeccd93e575.mp3",
+      "bytes": 56160,
+      "duration": 9.36,
+      "sha256": "3efea7c31c26d0f3841aff09e2ceb39ffed14e7327e5a05e06da41b0524cc27e",
+      "decode": "PASS"
+    },
+    {
+      "id": "95547def54daa061",
+      "text": "雨刮器中速摆动。两个雨刮一起扫过玻璃。天气不会改变你手动选择的档位。",
+      "file": "../assets/cockpit-voice/95547def54daa061.mp3",
+      "bytes": 56304,
+      "duration": 9.384,
+      "sha256": "69e2bdfbaf1477d44e6c4a704b451e66a0fbcb1e25b28db293b7f89af26e2807",
+      "decode": "PASS"
+    },
+    {
+      "id": "9941a017305d7065",
+      "text": "雨刮器高速摆动。两个雨刮一起扫过玻璃。天气不会改变你手动选择的档位。",
+      "file": "../assets/cockpit-voice/9941a017305d7065.mp3",
+      "bytes": 56016,
+      "duration": 9.336,
+      "sha256": "46b8de069515320db45878d7bf942647b4de9c73fbc58ee10e32d6c729d3c7df",
+      "decode": "PASS"
+    },
+    {
+      "id": "ec8db53118bb3f07",
+      "text": "天黑了。注意看路，夜间需要合适的车灯。",
+      "file": "../assets/cockpit-voice/ec8db53118bb3f07.mp3",
+      "bytes": 33264,
+      "duration": 5.544,
+      "sha256": "42563e4578f55141d953e916583019c447fd5743ef73695f46fa6e2faee378e6",
+      "decode": "PASS"
+    },
+    {
+      "id": "bc177ef8844d6b6b",
+      "text": "天亮了。现在是白天。",
+      "file": "../assets/cockpit-voice/bc177ef8844d6b6b.mp3",
+      "bytes": 22608,
+      "duration": 3.768,
+      "sha256": "9b7e8d01259906edd78972a2757bc35415bf92f379aa925ec9309b8c50da0c50",
+      "decode": "PASS"
+    },
+    {
+      "id": "35a01351154afb79",
+      "text": "行驶中不能解安全带。先安全停车，再解开安全带。",
+      "file": "../assets/cockpit-voice/35a01351154afb79.mp3",
+      "bytes": 40032,
+      "duration": 6.672,
+      "sha256": "f8c56754c0d39a08e6a0a32e3e5894cd4a08dc5d96afb4541c35152ea9077923",
+      "decode": "PASS"
+    },
+    {
+      "id": "98dbf9645d530d52",
+      "text": "请先安全停车。熄火后再解开安全带。",
+      "file": "../assets/cockpit-voice/98dbf9645d530d52.mp3",
+      "bytes": 32112,
+      "duration": 5.352,
+      "sha256": "380ee5045e63ece7face96cd7f6006964d014415f05278b3176840945d796271",
+      "decode": "PASS"
+    },
+    {
+      "id": "fbe990a21bb4103e",
+      "text": "安全带系好啦。出发前系好安全带。",
+      "file": "../assets/cockpit-voice/fbe990a21bb4103e.mp3",
+      "bytes": 27936,
+      "duration": 4.656,
+      "sha256": "5513da057548583c0ec33beaabed556d1d336134625bbb52d1bbd2135bfa47d1",
+      "decode": "PASS"
+    },
+    {
+      "id": "3e4832ff1c873102",
+      "text": "安全带解开了。停车后才能解安全带。",
+      "file": "../assets/cockpit-voice/3e4832ff1c873102.mp3",
+      "bytes": 31104,
+      "duration": 5.184,
+      "sha256": "5151be3355642c7f47ec50cc80004139ae35e4183adb323dd06a5d3af5d4538c",
+      "decode": "PASS"
+    },
+    {
+      "id": "7c59e6ca63feaf98",
+      "text": "先挂 P 挡。发动机启动前请先挂停车挡。",
+      "file": "../assets/cockpit-voice/7c59e6ca63feaf98.mp3",
+      "bytes": 35280,
+      "duration": 5.88,
+      "sha256": "39bc433df678ed69e447bdfa267d0c2925fb5860cfd00cdec094aeb1ec4c587d",
+      "decode": "PASS"
+    },
+    {
+      "id": "595d38d64985be1d",
+      "text": "先踩住脚刹。点一下脚刹，再启动发动机。",
+      "file": "../assets/cockpit-voice/595d38d64985be1d.mp3",
+      "bytes": 33120,
+      "duration": 5.52,
+      "sha256": "1437b20aee4576e23afea3128f84362fe10c0cd44d8661aecaf9e7d5e24a684f",
+      "decode": "PASS"
+    },
+    {
+      "id": "417fe169ef8a9040",
+      "text": "发动机启动啦。继续系安全带、挂 D 或 S 挡，再松手刹。",
+      "file": "../assets/cockpit-voice/417fe169ef8a9040.mp3",
+      "bytes": 42480,
+      "duration": 7.08,
+      "sha256": "e2d193bd284278e869a0970d336963d7de6106a30e516c8cd397a92821a38eec",
+      "decode": "PASS"
+    },
+    {
+      "id": "48b06c8d649b4d84",
+      "text": "还不能熄火。先踩刹车停稳、拉手刹、挂 P 挡，再熄火。",
+      "file": "../assets/cockpit-voice/48b06c8d649b4d84.mp3",
+      "bytes": 44352,
+      "duration": 7.392,
+      "sha256": "1b6e33178f4c641a22bf44ccc3d6f956300c216f6b12b123bb6cbfcbec3260d8",
+      "decode": "PASS"
+    },
+    {
+      "id": "20c446a565a8d664",
+      "text": "发动机熄火啦。最后松开脚刹，就安全停车啦。",
+      "file": "../assets/cockpit-voice/20c446a565a8d664.mp3",
+      "bytes": 35136,
+      "duration": 5.856,
+      "sha256": "9732e69d7bcd896d9e0a09beb5d35cb228d60ddaf7eb5f96dcc2f306021fc879",
+      "decode": "PASS"
+    },
+    {
+      "id": "94f5f1825c74d394",
+      "text": "行驶中不能这样换挡。先刹车停稳，再换到 P、R 或 N。",
+      "file": "../assets/cockpit-voice/94f5f1825c74d394.mp3",
+      "bytes": 44640,
+      "duration": 7.44,
+      "sha256": "7773d98bd32436185faa5b500b2cc11b490a76ec3a82fd4d66d2688f40a9573d",
+      "decode": "PASS"
+    },
+    {
+      "id": "cafd3b676145e125",
+      "text": "换挡前踩脚刹。先点击脚刹，模拟踩住制动踏板。",
+      "file": "../assets/cockpit-voice/cafd3b676145e125.mp3",
+      "bytes": 39312,
+      "duration": 6.552,
+      "sha256": "7f2124fa0ff8fdb3f24b4b891437927f97c2fa8103b7f7702c0989e444e4ec98",
+      "decode": "PASS"
+    },
+    {
+      "id": "ed46cd175a6ff22a",
+      "text": "先启动发动机。请保持 P 挡，踩脚刹后启动。",
+      "file": "../assets/cockpit-voice/ed46cd175a6ff22a.mp3",
+      "bytes": 35280,
+      "duration": 5.88,
+      "sha256": "f7e0e3325bcddc6371f1001988cb7fe0bffba42ddbf155d000f59b0b1d0ffb8f",
+      "decode": "PASS"
+    },
+    {
+      "id": "8e21797950bca7dc",
+      "text": "先系安全带。驾驶前系好安全带。",
+      "file": "../assets/cockpit-voice/8e21797950bca7dc.mp3",
+      "bytes": 27792,
+      "duration": 4.632,
+      "sha256": "9fda4a8195944e238919dfba18b5104ade00b8314e48e219786c36eb82a26014",
+      "decode": "PASS"
+    },
+    {
+      "id": "f60274ef8983923d",
+      "text": "先拉手刹。停稳、踩住脚刹、拉手刹，再挂 P。",
+      "file": "../assets/cockpit-voice/f60274ef8983923d.mp3",
+      "bytes": 40896,
+      "duration": 6.816,
+      "sha256": "21fe40bde4b34068a8821ceb00c0a0b5d6497a37464b8628b224b1daaae8e931",
+      "decode": "PASS"
+    },
+    {
+      "id": "5b2ffea950dac020",
+      "text": "先刹车停稳。汽车还在动，不能在行驶中拉驻车制动。",
+      "file": "../assets/cockpit-voice/5b2ffea950dac020.mp3",
+      "bytes": 41760,
+      "duration": 6.96,
+      "sha256": "ee5a400a97724e1498285e687915a2e35414f4af431d3da0cb24c1145fdd6514",
+      "decode": "PASS"
+    },
+    {
+      "id": "480320a15a917c3c",
+      "text": "先踩住脚刹。按住脚刹后再操作驻车制动。",
+      "file": "../assets/cockpit-voice/480320a15a917c3c.mp3",
+      "bytes": 33840,
+      "duration": 5.64,
+      "sha256": "15d2b5d36d2ee819dfddaec1bbf5d78cf4153783436818bcdb173bb67a9b1f96",
+      "decode": "PASS"
+    },
+    {
+      "id": "c4f2051086aa5ed1",
+      "text": "还不能松手刹。先启动车辆、系安全带，选择前进挡或倒挡。",
+      "file": "../assets/cockpit-voice/c4f2051086aa5ed1.mp3",
+      "bytes": 45216,
+      "duration": 7.536,
+      "sha256": "6fd086f8e31050fcfc9ac3e76e032a80b76f4646242bf39adb9cb1ca94a28dd5",
+      "decode": "PASS"
+    },
+    {
+      "id": "04ae0f529cfc1e27",
+      "text": "手刹已经拉起。停车时拉起驻车制动。",
+      "file": "../assets/cockpit-voice/04ae0f529cfc1e27.mp3",
+      "bytes": 32544,
+      "duration": 5.424,
+      "sha256": "c2726b4b2d7655fdbde8bb222d9310be1ec9d8a96e43e73ca60382e9e7a0ce15",
+      "decode": "PASS"
+    },
+    {
+      "id": "fb1307dd53bd2cc9",
+      "text": "手刹松开啦。松开脚刹后，可以踩油门出发。",
+      "file": "../assets/cockpit-voice/fb1307dd53bd2cc9.mp3",
+      "bytes": 34128,
+      "duration": 5.688,
+      "sha256": "15f60a6abaed5921a5c4b5f44e8dfb0318d019cee0f74a0ffded48928c6b65d1",
+      "decode": "PASS"
+    },
+    {
+      "id": "7b8f30983ca70c38",
+      "text": "车门锁好了。现在车门锁已锁定。",
+      "file": "../assets/cockpit-voice/7b8f30983ca70c38.mp3",
+      "bytes": 28512,
+      "duration": 4.752,
+      "sha256": "8927750312573e822b44ae7895b6191a0bca9723a564e4c2cf906dfeddddee15",
+      "decode": "PASS"
+    },
+    {
+      "id": "7658eeacc1153f42",
+      "text": "车门解锁啦。现在可以开门。",
+      "file": "../assets/cockpit-voice/7658eeacc1153f42.mp3",
+      "bytes": 24768,
+      "duration": 4.128,
+      "sha256": "fdf7a0a827e1230e435e648d0f76aee2e532b79d75c82789e680213c16c2446a",
+      "decode": "PASS"
+    },
+    {
+      "id": "ab116082e88c27c3",
+      "text": "车窗打开了。感受窗外的风。",
+      "file": "../assets/cockpit-voice/ab116082e88c27c3.mp3",
+      "bytes": 24768,
+      "duration": 4.128,
+      "sha256": "a23f742483b9e0f0476dd3ceebed1ce26e96a7579dc74293c3ee2dee6fe777d8",
+      "decode": "PASS"
+    },
+    {
+      "id": "49daad375af7a13b",
+      "text": "车窗关好了。玻璃升上来了。",
+      "file": "../assets/cockpit-voice/49daad375af7a13b.mp3",
+      "bytes": 24048,
+      "duration": 4.008,
+      "sha256": "428eb70ce057e17343e14039d55515f4a2e78c51c91285cc9bd852435bfd772f",
+      "decode": "PASS"
+    },
+    {
+      "id": "07151d52d0cd5100",
+      "text": "换到 P 挡。停车模式。准备停车。",
+      "file": "../assets/cockpit-voice/07151d52d0cd5100.mp3",
