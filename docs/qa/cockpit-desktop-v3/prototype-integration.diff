+/* Integration: real navigation, clear child-simulation label and accessible return target. */
+a.outline{display:block;text-align:center;text-decoration:none;min-height:44px;flex-shrink:0}
+a.outline:focus-visible{outline:3px solid var(--teal);outline-offset:3px}
+.footer button .en{color:#315565}
+/* Keep transient feedback over scenery, away from the footer and operating controls. */
+.attract{position:absolute;left:50%;right:auto;top:80px;bottom:auto;width:calc(100% - 48px);transform:translate(-50%,10px)}
+.attract.show{transform:translate(-50%,0)}
+/* V3.1: two coordinated, clipped wipers and five independent rain levels. */
+.wiper-system{position:absolute;inset:0;width:100%;height:100%;overflow:hidden;z-index:7;pointer-events:none;filter:drop-shadow(0 2px 2px #06233299)}
+.wiper-arm{fill:none;stroke:#71858b;stroke-width:8;stroke-linecap:round}.wiper-blade{fill:none;stroke:#10232c;stroke-width:12;stroke-linecap:round}.wiper-pivot{fill:#10232c;stroke:#8aa0a5;stroke-width:3}
+.windshield .drop{display:none;top:-35px;height:24px;width:2px;animation-name:cockpitRain;animation-duration:calc(var(--fall-time) * var(--rain-speed,1));animation-timing-function:linear}
+.windshield.rain-level-1{--rain-speed:1.6}.windshield.rain-level-2{--rain-speed:1.15}.windshield.rain-level-3{--rain-speed:.82}.windshield.rain-level-4{--rain-speed:.44}
+.windshield.rain-level-1 .drop:nth-child(-n+18),.windshield.rain-level-2 .drop:nth-child(-n+45),.windshield.rain-level-3 .drop:nth-child(-n+90),.windshield.rain-level-4 .drop{display:block}
+.windshield.rain-level-4 .drop{height:30px;width:2.4px}.windshield.storm .world svg{filter:brightness(.84) saturate(.82)}
+@keyframes cockpitRain{from{transform:translate3d(15px,0,0) rotate(12deg)}to{transform:translate3d(-45px,var(--rain-travel,480px),0) rotate(12deg)}}
+.windshield:not(.raining) .rain-screen,.windshield:not(.snowy) .snow-screen{visibility:hidden;opacity:0;transition:none}
+.windshield:not(.snowy) .flake{animation-play-state:paused}
+#rainButtons,#wiperButtons{display:grid;gap:6px}#rainButtons{grid-template-columns:repeat(6,minmax(0,1fr))}#wiperButtons{grid-template-columns:repeat(4,minmax(0,1fr))}.wiper-help{font-size:11px;color:var(--muted);line-height:1.4;margin:0 0 6px}
+@media(min-width:1000px) and (min-height:620px){
+ .left-stack{grid-template-rows:minmax(0,44fr) auto minmax(0,56fr)}
+ .footer #voiceToggle{display:grid;grid-template-columns:24px 1fr;grid-template-rows:auto auto;column-gap:5px;align-content:center;min-height:44px}
+ .footer #voiceToggle .btn-symbol{grid-row:1 / 3;align-self:center;margin:0}
+ .footer{min-height:56px}.instruments{grid-template-rows:20px minmax(0,1fr) 24px minmax(112px,.74fr)}
+ .wheel{width:clamp(72px,10vh,132px);height:clamp(72px,10vh,132px)}
+}
+@media(max-width:999px){#rainButtons{grid-template-columns:repeat(3,minmax(0,1fr))}#rainButtons .key,#wiperButtons .key{min-width:0}}
